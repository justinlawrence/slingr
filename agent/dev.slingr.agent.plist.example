<?xml version="1.0" encoding="UTF-8"?>
<!-- Written into ~/Library/LaunchAgents by `./spaces.sh on`, which fills in
     the paths. KeepAlive only on a crash: quitting from the menu bar is a
     decision, and a crash is not. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.slingr.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>SLINGR_AGENT</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardErrorPath</key>
	<string>SLINGR_LOG</string>
</dict>
</plist>

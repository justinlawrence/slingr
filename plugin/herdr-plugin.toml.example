# Herdr fires these when the focused tab changes, so the matching workspace or
# desktop can follow along without slingr staying resident.
#
# herdr needs an absolute path, which a repository cannot know, so `install.sh`
# and `spaces.sh` write the real one into plugin/herdr-plugin.toml and link it.

id = "slingr"
name = "slingr"
version = "0.1.0"
min_herdr_version = "0.9.0"
description = "Go to the workspace or desktop matching the focused herdr tab, and say when an agent wants you."
platforms = ["macos"]

[[events]]
on = "tab.focused"
command = ["SLINGR_BINARY", "goto"]

# A tab is a task, so a new or renamed one has to reach AeroSpace's
# persistent-workspaces before it can be gone to. Without these, a brand-new
# task has no workspace until something else happens to run a sync. With
# Spaces a sync writes nothing: a task takes its desktop on its first visit.
[[events]]
on = "tab.created"
command = ["SLINGR_BINARY", "sync"]

[[events]]
on = "tab.renamed"
command = ["SLINGR_BINARY", "sync"]

# An agent that needs input, or has finished while you were elsewhere, is said
# in a notification that goes to its pane when clicked; on macOS herdr's own
# cannot. Turn herdr's off with `[ui.toast] delivery = "off"` in
# ~/.config/herdr/config.toml, or each one comes twice.
[[events]]
on = "pane.agent_status_changed"
command = ["SLINGR_BINARY", "notify"]

# Herdr fires this when the focused tab changes, so AeroSpace can follow along
# without anything staying resident.
#
# herdr needs an absolute path, which a repository cannot know, so `install.sh`
# writes the real one into plugin/herdr-plugin.toml and links that.

id = "slingr"
name = "slingr"
version = "0.1.0"
min_herdr_version = "0.9.0"
description = "Bring AeroSpace to the workspace matching the focused herdr tab."
platforms = ["macos"]

[[events]]
on = "tab.focused"
command = ["SLINGR_BINARY", "goto"]

# A tab is a task, so a new or renamed one has to reach AeroSpace's
# persistent-workspaces before it can be gone to. Without these, a brand-new
# task has no workspace until something else happens to run a sync.
[[events]]
on = "tab.created"
command = ["SLINGR_BINARY", "sync"]

[[events]]
on = "tab.renamed"
command = ["SLINGR_BINARY", "sync"]
